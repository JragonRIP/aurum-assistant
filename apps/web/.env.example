# Copy this file to apps/web/.env.local and fill in real values.
# See root .env.example for full documentation.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# SERVER ONLY — never expose to the browser or Electron renderer
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# GEMINI_TEXT_MODEL=gemini-3.6-flash

# Spotify OAuth (Phase 4.1) — server only
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/integrations/spotify/callback
# Optional: 64-char hex or any passphrase; defaults to SHA-256(SUPABASE_SERVICE_ROLE_KEY)
# INTEGRATION_TOKEN_KEY=
