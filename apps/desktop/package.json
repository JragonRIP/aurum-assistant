{
  "name": "@aurum/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Aurum Windows desktop companion",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc -p tsconfig.json && node scripts/build-renderer.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "electron ."
  },
  "dependencies": {
    "@aurum/shared": "^0.1.0",
    "@aurum/ui": "^0.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^35.0.1",
    "typescript": "^5.8.2",
    "vite": "^6.4.3"
  }
}
