# Aurum Windows desktop companion — backend URL
#
# Copy to `.env` or `.env.local` in this folder (gitignored).
# Loaded by the Electron main process only (never the renderer).
#
# Default (no file / unset): production Vercel backend.
# Override intentionally for local web development.

# Production (recommended for daily use of the Windows companion):
AURUM_WEB_URL=https://aurum-assistant-aurum-web-design.vercel.app

# Local development (run apps/web first, then desktop):
# AURUM_WEB_URL=http://127.0.0.1:3000

# Packaged Windows installs default to production with no .env file required.
# Optional override for an installed build: %APPDATA%\Aurum\.env
#
# Release publishing (build machine only — never ship in the app):
#   set GH_TOKEN to a GitHub PAT, then: npm run release:desktop
# Public release downloads do not require a token in the installed app.
