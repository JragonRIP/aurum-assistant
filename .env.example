# =============================================================================
# AURUM ENVIRONMENT CONFIGURATION
# Copy to apps/web/.env.local (and optionally root .env) and fill in values.
# NEVER commit real secrets. NEVER expose server-only keys to clients.
# =============================================================================

# -----------------------------------------------------------------------------
# PUBLIC CLIENT CONFIG (safe for browser / Electron renderer)
# Prefix with NEXT_PUBLIC_ so Next.js can expose them to the client.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# -----------------------------------------------------------------------------
# SERVER-ONLY SECRETS (never NEXT_PUBLIC_*, never in Electron renderer)
# -----------------------------------------------------------------------------

SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Gemini API key — Phase 2+. Server only. Never ship to clients.
GEMINI_API_KEY=your_gemini_api_key

# Optional: override default text model (default: gemini-2.5-flash)
# GEMINI_TEXT_MODEL=gemini-3.6-flash

# -----------------------------------------------------------------------------
# DESKTOP (apps/desktop) — Electron main process only
# Single authoritative backend URL for pairing, bridge, overlay, device chat.
# Default when unset: https://aurum-assistant-aurum-web-design.vercel.app
# Copy apps/desktop/.env.example → apps/desktop/.env.local to override.
# -----------------------------------------------------------------------------

AURUM_WEB_URL=https://aurum-assistant-aurum-web-design.vercel.app
# Local web override:
# AURUM_WEB_URL=http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# DESKTOP RELEASE PUBLISH
# Preferred: push a version tag (v0.2.4) — GitHub Actions publishes with GITHUB_TOKEN.
# Optional local-only publish (never commit a real token):
#   PowerShell:  $env:GH_TOKEN = "YOUR_TOKEN"
#   Then: npm run release:desktop
# Installed Aurum downloads public releases without any token.
# -----------------------------------------------------------------------------
# GH_TOKEN=

# -----------------------------------------------------------------------------
# SPOTIFY (Phase 4.1 connected app — server only)
# -----------------------------------------------------------------------------

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/integrations/spotify/callback
# Optional encryption key for OAuth tokens at rest (else SHA-256 of service role key)
# INTEGRATION_TOKEN_KEY=
